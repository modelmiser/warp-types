#!/bin/bash
# Pre-push hook: mirrors GitHub CI checks (ci.yml)
# Catches fmt + clippy + test failures before they hit remote.

set -e

echo "pre-push: cargo fmt --check"
cargo fmt --check

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: cargo test --workspace --lib"
cargo test --workspace --lib --quiet

echo "pre-push: cargo test --workspace --doc"
cargo test --workspace --doc --quiet

# The `gpu` feature is the one non-default feature CI cannot build — no CUDA
# runner. That gap is a DECISION (see TODO), but it means the CUDA path can
# compile-rot between hardware sessions with nothing reporting it, which is
# exactly the failure the fuzz-target `cargo check` step exists to catch in CI.
#
# Closing it here costs ~7s and needs no GPU at runtime, only the CUDA headers
# that cudarc links against. Skipped automatically on a machine without them, so
# the hook stays portable — a fresh clone elsewhere is not blocked by this.
if [ -d /usr/local/cuda ] || command -v nvcc &>/dev/null; then
    echo "pre-push: cargo check -p warp-types-sat --features gpu (CUDA path, PTX rebuilt)"
    # The PTX is produced by warp-types-sat's build script and cached; a
    # `cargo check` that reuses the cache proves nothing about the kernel crate
    # or the builder (2026-11-02: the builder's target-cpu flag had been
    # rejected by rustc for weeks behind a cached PTX, and a kernel whose panic
    # path left undefined externs in the module passed this step). Touching the
    # kernel crate's root forces the build script, and so the device build, to
    # run again — ~20 s, still no GPU needed.
    touch warp-types-sat/sat-kernels/src/lib.rs
    cargo check -p warp-types-sat --features gpu --quiet
    ptx=$(ls -t target/debug/build/warp-types-sat/*/out/kernels.ptx 2>/dev/null | head -1)
    if [ -n "$ptx" ] && grep -q '\.extern' "$ptx"; then
        echo "pre-push: FAIL — kernels.ptx declares undefined externs (a panic path survived):"
        grep -n '\.extern' "$ptx" | head -5
        exit 1
    fi
    # The workspace clippy above builds without the feature, so the CUDA path's
    # launchers and tests went unlinted: tests/kernel_fuse_profile.rs carried three
    # -D warnings failures for weeks (found 2026-11-03, fixed 2026-11-04).
    echo "pre-push: cargo clippy -p warp-types-sat --features gpu --all-targets -- -D warnings"
    cargo clippy -p warp-types-sat --features gpu --all-targets --quiet -- -D warnings
else
    echo "pre-push: skipping gpu-feature check (no CUDA toolkit on this host)"
fi

# The four device-target clippies CI runs (ci.yml, job nvptx). Not covered by
# the host clippy above: a lint in a kernel crate failed CI on three pushes in a
# row (2026-11-04, `k - 1 >= LRAT_TABLE` in sat-kernels) while this hook passed.
for m in "-p warp-types" \
         "--manifest-path warp-types-sat/sat-kernels/Cargo.toml" \
         "--manifest-path examples/gpu-project/my-kernels/Cargo.toml" \
         "--manifest-path tools/ptxprobe/Cargo.toml"; do
    echo "pre-push: cargo clippy $m --target nvptx64-nvidia-cuda -- -D warnings"
    # shellcheck disable=SC2086 # $m is two words on purpose
    cargo clippy $m --target nvptx64-nvidia-cuda --quiet -- -D warnings
done

echo "pre-push: PTX operands (membermask / width reach shfl.sync)"
bash scripts/check-ptx-operands.sh

echo "pre-push: paper sync (section files == paper.md spans)"
bash scripts/check-paper-sync.sh

echo "pre-push: doc count freshness"
bash scripts/check-doc-counts.sh

echo "pre-push: all checks passed"
